{
    "name": "karneaud/omniship-common",
    "description": "A unified, extensible library for integrating shipping carriers with standardized property management.",
    "type": "library",
    "license": "MIT",
    "version": "2.0",
    "authors": [
        {
            "name": "Kendall Arneaud",
            "email": "kendall.arneaud@gmail.com"
        }
    ],
    "extra": { "branch-alias": { "dev-version/2.0": "2.0.x-dev" } },
    "require": {
        "php": "^8.1",
        "hackerpro536/stringy": "^1.0"
    },
    "suggest": {
        "commerceguys/addressing": "For address validation and formatting (optional)",
        "moneyphp/money": "For precise monetary calculations (optional)",
        "php-units-of-measure/php-units-of-measure": "For unit conversion (optional)",
        "guzzlehttp/guzzle": "For HTTP client functionality (optional)",
        "dvdoug/boxpacker": "For 4d box packing"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",                      
        "squizlabs/php_codesniffer": "^3.7",           
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7", 
        "fakerphp/faker": "^1.20",                     
        "mockery/mockery": "^1.5",                     
        "roave/security-advisories": "dev-latest"      
    },
    "autoload": {
        "psr-4": {
            "Omniship\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omniship\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs src/ --standard=PSR12",
        "fix": "phpcbf src/ --standard=PSR12",
        "post-install-cmd": [
            "@lint"
        ],
        "post-update-cmd": [
            "@lint"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": false,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
